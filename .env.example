# claude-bridge config

# Server bind
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=4203

# Credential pool — directory containing sub-N dirs (one per Claude Code subscription).
# Each sub-N has .claude/.credentials.json from `CLAUDE_CONFIG_DIR=/etc/claude-pool/sub-N claude auth login`.
CREDENTIAL_POOL_DIR=/etc/claude-pool

# SQLite session registry (conversation_id → claude_session_id + metadata)
REGISTRY_DB_PATH=/var/lib/claude-bridge/sessions.db

# Per-subscription cooldown after a rate_limit / overloaded error (seconds)
CREDENTIAL_COOLDOWN_SECONDS=75

# Bot configuration
BOTS_CONFIG_PATH=/etc/claude-bridge/config/bots.yaml

# Workspace base — each Bot gets /workspace/<bot_id>
WORKSPACE_BASE=/workspace

# Per-turn timeout (seconds) before the PTY is killed and the session respawned via --resume
TURN_TIMEOUT_SECONDS=120

# Log level
LOG_LEVEL=INFO